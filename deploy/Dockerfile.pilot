FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG COMMIT=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w -X main.commit=${COMMIT}" -o /out/bot ./cmd/bot \
    && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -o /out/migration-plan ./cmd/migration-plan

FROM alpine:3.24
RUN apk add --no-cache ca-certificates \
    && addgroup -g 10001 store \
    && adduser -D -H -u 10001 -G store store \
    && mkdir /app /data \
    && chown 10001:10001 /data \
    && chmod 0700 /data
WORKDIR /app
COPY --from=build --chmod=0555 /out/bot /out/migration-plan /app/
COPY --chmod=0444 LICENSE THIRD-PARTY-NOTICES.md /app/
ENV DATA_DIR=/data
USER 10001:10001
VOLUME ["/data"]
ENTRYPOINT ["/app/bot"]
